{
  "routes": [
    {
      "src": "/assets/(.*)",
      "headers": { "Access-Control-Allow-Origin": "*" },
      "continue": true
    },
    {
      "src": "/(.*)",
      "has": [{ "type": "host", "value": "www.taktab.ru" }],
      "status": 308,
      "headers": { "Location": "https://taktab.ru/$1" }
    },
    { "src": "/", "dest": "/welcome.html" },
    { "handle": "filesystem" },
    { "src": "/.*", "dest": "/index.html" }
  ]
}
